# Copie para .env (que NUNCA vai para o git: o repositório é público).
MONGO_URL=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=canteiro
PUBSUB_EMULATOR_HOST=localhost:8085
GCP_PROJECT=canteiro-local
# segredo do JWT do login próprio: gere com  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SEGREDO=
API_URL=http://localhost:8000
# chave da Anthropic da PLATAFORMA (clientes de créditos). Chave própria de cliente fica cifrada no banco, nunca aqui.
ANTHROPIC_API_KEY=
