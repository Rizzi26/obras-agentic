  "components": [
    {
      "name": "Botão Ouro",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação principal: entrar na lista, aprovar uma decisão.",
      "html": "<button class=\"ds-btn-ouro\">Entrar na lista</button>",
      "css": ".ds-btn-ouro{font-family:\"Figtree\",system-ui,sans-serif;display:inline-flex;align-items:center;min-height:48px;padding:0 22px;border-radius:999px;border:0;background:#e8b04a;color:#0f1a2e;font-weight:650;font-size:16px;cursor:pointer;box-shadow:inset 0 1px 0 rgba(255,255,255,.35),0 4px 12px -4px rgba(4,8,18,.45);transition:transform 160ms cubic-bezier(.23,1,.32,1),background-color 160ms cubic-bezier(.23,1,.32,1)}.ds-btn-ouro:hover{background:#f2c56b}.ds-btn-ouro:active{transform:scale(.97)}.ds-btn-ouro:focus-visible{outline:2px solid #f2c56b;outline-offset:3px}"
    },
    {
      "name": "Botão Linha",
      "kind": "button",
      "refersTo": "button-linha",
      "description": "Ação secundária na noite: costurada, não preenchida.",
      "html": "<div class=\"ds-noite\"><button class=\"ds-btn-linha\">Ver o exemplo</button></div>",
      "css": ".ds-noite{background:#0f1a2e;padding:24px}.ds-btn-linha{font-family:\"Figtree\",system-ui,sans-serif;min-height:48px;padding:0 22px;border-radius:999px;background:transparent;color:#eef1f6;border:1px dashed rgba(240,234,218,.78);font-weight:650;font-size:16px;cursor:pointer;transition:background-color 160ms cubic-bezier(.23,1,.32,1)}.ds-btn-linha:hover{background:rgba(255,255,255,.06)}.ds-btn-linha:focus-visible{outline:2px solid #f2c56b;outline-offset:3px}"
    },
    {
      "name": "Inscrição do hero",
      "kind": "input",
      "refersTo": "input-inscricao",
      "description": "Pílula de vidro com e-mail e botão juntos, no primeiro viewport.",
      "html": "<div class=\"ds-noite\"><form class=\"ds-inscricao\"><input type=\"email\" placeholder=\"seu@email.com.br\" aria-label=\"E-mail\"><button type=\"button\" class=\"ds-btn-ouro2\">Entrar na lista</button></form></div>",
      "css": ".ds-noite{background:#0f1a2e;padding:24px}.ds-inscricao{display:flex;gap:8px;max-width:520px;padding:6px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.14);transition:border-color 200ms}.ds-inscricao:focus-within{border-color:rgba(232,176,74,.7);background:rgba(255,255,255,.1)}.ds-inscricao input{font-family:\"Figtree\",system-ui,sans-serif;flex:1;min-width:0;background:none;border:0;padding:0 16px;font-size:17px;color:#eef1f6;caret-color:#e8b04a;outline:none}.ds-inscricao input::placeholder{color:#8f9bb1}.ds-btn-ouro2{font-family:\"Figtree\",system-ui,sans-serif;min-height:48px;padding:0 22px;border-radius:999px;border:0;background:#e8b04a;color:#0f1a2e;font-weight:650;font-size:16px;cursor:pointer}.ds-btn-ouro2:hover{background:#f2c56b}"
    },
    {
      "name": "Campo da ficha",
      "kind": "input",
      "refersTo": "input-campo",
      "description": "Campo de texto na manhã, dentro da ficha de inscrição.",
      "html": "<label class=\"ds-campo\"><span>Nome</span><input placeholder=\"Como podemos te chamar\"></label>",
      "css": ".ds-campo{font-family:\"Figtree\",system-ui,sans-serif;display:grid;gap:7px;color:#15201c;background:#fbfcfb;padding:20px}.ds-campo span{font-size:15px;font-weight:650}.ds-campo input{font-family:\"Figtree\",system-ui,sans-serif;min-height:50px;padding:0 14px;border-radius:14px;border:1px solid #c2cac6;background:#fff;font-size:17px;color:#15201c;caret-color:#7a5410;transition:border-color 160ms,box-shadow 160ms}.ds-campo input::placeholder{color:#7a8580}.ds-campo input:focus{outline:none;border-color:#a06a16;box-shadow:0 0 0 4px rgba(232,176,74,.25)}"
    },
    {
      "name": "Chip de função",
      "kind": "chip",
      "refersTo": "chip-papel",
      "description": "Escolha única da função de quem se inscreve.",
      "html": "<div class=\"ds-papel\"><label><input type=\"radio\" name=\"p\" checked><span>Gerente de obra</span></label><label><input type=\"radio\" name=\"p\"><span>Dono da obra</span></label></div>",
      "css": ".ds-papel{font-family:\"Figtree\",system-ui,sans-serif;display:flex;gap:8px;flex-wrap:wrap}.ds-papel label{position:relative;cursor:pointer;font-size:15px;font-weight:550}.ds-papel input{position:absolute;opacity:0;inset:0}.ds-papel span{display:inline-flex;align-items:center;min-height:42px;padding:0 14px;border-radius:999px;border:1px solid #c2cac6;background:#fff;color:#15201c;transition:background-color 160ms,color 160ms}.ds-papel input:checked+span{background:#15201c;border-color:#15201c;color:#fff}.ds-papel input:focus-visible+span{outline:2px solid #7a5410;outline-offset:2px}"
    },
    {
      "name": "Navbar costurada",
      "kind": "nav",
      "refersTo": "",
      "description": "Faixa pílula de vidro azul-noite, solta do topo, com costura interna.",
      "html": "<div class=\"ds-fundo\"><nav class=\"ds-nav\"><a class=\"ds-marca\" href=\"#\">Plumo</a><a class=\"ds-link\" href=\"#\">Como funciona</a><a class=\"ds-link\" href=\"#\">Perguntas</a></nav></div>",
      "css": ".ds-fundo{background:#16243d;padding:20px}.ds-nav{font-family:\"Figtree\",system-ui,sans-serif;display:flex;align-items:center;gap:8px;padding:7px 16px;border-radius:999px;background:rgba(15,26,46,.62);backdrop-filter:blur(18px) saturate(160%);border:1px solid rgba(255,255,255,.09);outline:1px dashed rgba(232,226,210,.26);outline-offset:-6px;box-shadow:0 2px 6px rgba(4,8,18,.25),0 18px 48px -16px rgba(4,8,18,.6)}.ds-marca{font:700 21px \"Bricolage Grotesque\",system-ui,sans-serif;letter-spacing:-.03em;color:#eef1f6;text-decoration:none;margin-right:auto}.ds-link{padding:9px 14px;border-radius:999px;color:#aab5c8;text-decoration:none;font-size:15px;font-weight:550;transition:color 160ms,background-color 160ms}.ds-link:hover{color:#eef1f6;background:rgba(255,255,255,.07)}.ds-link:focus-visible{outline:2px solid #f2c56b;outline-offset:3px}"
    },
    {
      "name": "Bilhete do agente",
      "kind": "card",
      "refersTo": "card-bilhete",
      "description": "Nota costurada em vidro onde o agente escreve a falta prevista, a conta e a fonte.",
      "html": "<div class=\"ds-fundo2\"><div class=\"ds-bilhete\"><div class=\"ds-topo\"><i class=\"ds-clima\"></i>Residencial Aroeira<span class=\"ds-hora\">23:40</span></div><p class=\"ds-conta\">precisa 120 − saldo 40 − a caminho 0 = <b>falta 80</b></p><p class=\"ds-fonte\">Fonte: almoxarifado · exemplo fictício</p></div></div>",
      "css": ".ds-fundo2{background:#0f1a2e;padding:24px}.ds-bilhete{font-family:\"Figtree\",system-ui,sans-serif;max-width:440px;padding:22px 22px 18px;border-radius:20px;background:rgba(22,36,61,.78);backdrop-filter:blur(14px);border:1px solid rgba(255,255,255,.1);outline:1px dashed rgba(232,226,210,.42);outline-offset:-8px;box-shadow:0 30px 80px -30px rgba(0,0,0,.7);color:#dbe1ec}.ds-topo{display:flex;align-items:center;gap:10px;font-weight:700;font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:#eef1f6;padding:0 4px 14px}.ds-hora{margin-left:auto;letter-spacing:0;font-weight:500;color:#aab5c8}.ds-clima{width:10px;height:10px;border-radius:50%;background:#d0654c}.ds-conta{margin:0;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.05);font-size:15px;color:#aab5c8;font-variant-numeric:tabular-nums}.ds-conta b{color:#ffc2b3}.ds-fonte{margin:14px 0 0;padding:12px 4px 0;border-top:1px dashed rgba(232,226,210,.2);font-size:13px;color:#8f9bb1}"
    },
    {
      "name": "Ficha de inscrição",
      "kind": "card",
      "refersTo": "card-ficha",
      "description": "Superfície de papel com costura interna, na manhã.",
      "html": "<div class=\"ds-manha\"><div class=\"ds-ficha\"><b>Ponha a sua obra no prumo.</b><span>Avisamos quando abrir a sua vaga.</span></div></div>",
      "css": ".ds-manha{background:#eef1ee;padding:24px}.ds-ficha{font-family:\"Figtree\",system-ui,sans-serif;display:grid;gap:10px;padding:32px;border-radius:28px;background:#fbfcfb;color:#15201c;outline:1px dashed #c4ccc7;outline-offset:-10px;box-shadow:0 30px 70px -40px rgba(20,36,30,.4)}.ds-ficha b{font:700 24px \"Bricolage Grotesque\",system-ui,sans-serif;letter-spacing:-.03em}.ds-ficha span{color:#4c5753;font-size:16px}"
    }
  ],
