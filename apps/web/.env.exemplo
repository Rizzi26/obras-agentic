# Copie para .env.local (fora do git: o repositório é público). Só o servidor do Next lê estas variáveis.

# 1 = modo de demonstração: o próprio Next responde com a Casa Vila Nova (dados fictícios, em memória).
CANTEIRO_DEMO=1

# Com CANTEIRO_DEMO vazio, o Next repassa para os serviços de verdade:
API_URL=http://localhost:8000
AGENTE_URL=http://localhost:8100

# A API lê o IP do cliente (limite de tentativas no login) do X-Forwarded-For que o Next repassa, mas só confia nele
# vindo de um IP listado em TRUSTED_PROXIES no .env DA API. Ponha lá o IP deste servidor do Next (em local: 127.0.0.1).
